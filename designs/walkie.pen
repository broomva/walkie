          "name": "Fallback title",
          "fill": "$lt-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "When the voice is poor",
          "fontFamily": "$font",
          "fontSize": 17,
          "fontWeight": "600",
          "letterSpacing": -0.2
        },
        {
          "type": "text",
          "id": "q2yxwF",
          "name": "Fallback body",
          "fill": "$lt-muted",
          "textGrowth": "fixed-width",
          "width": 840,
          "content": "Poor in both senses, and they land in the same place. Bad audio drops you into the thread with the exchange intact. A request voice is simply bad at — anything with a diff, a list, a blast radius — drops you into the same thread, same addressee, mid-conversation. The thread is not a degraded mode. It is the record the call is writing the whole time, and it is always one tap away.",
          "lineHeight": 1.6,
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
