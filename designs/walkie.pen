                      "name": "N",
                      "fill": "$lt-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Both at once. Your voice lifts every point; the run only tints the ones it is inside.",
                      "lineHeight": 1.5,
