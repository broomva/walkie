        {
          "type": "frame",
          "id": "MjHx5",
          "name": "Weather bleed",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 18,
          "children": [
            {
              "type": "text",
              "id": "H6ZB9A",
              "name": "Cap",
              "fill": "$lt-slate",
              "textGrowth": "fixed-width",
              "width": 880,
              "content": "What if the weather does not stop at the surface. The pools become volumes drifting through the sphere and the tide a plane sweeping it, so points light up as the run passes through them. Work moves in three dimensions, voice moves on the surface — which is what keeps them apart now that they share the same space.",
              "lineHeight": 1.55,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
