                    },
                    {
                      "type": "text",
                      "id": "N699yl",
                      "name": "N",
                      "fill": "$lt-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The page is the sphere. Lighter, and it belongs to a paper app — but the halo sits behind the points rather than around them, and the glow leaks into the middle.",
                      "lineHeight": 1.55,
                      "textAlign": "center",
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
