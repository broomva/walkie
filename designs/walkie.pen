              "fontWeight": "600",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "RmYg1",
              "name": "Lede",
              "fill": "$lt-slate",
              "textGrowth": "fixed-width",
              "width": 840,
              "content": "The architecture doc rejected an agent as the router. It did not reject an agent in the system — it rejected one in the critical path holding state. Put the orchestrator beside the fast path instead of inside it and every objection either retires or is answerable, while the thing you actually want — judgement, orchestration, and somewhere to think — becomes possible.",
              "lineHeight": 1.55,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "WAZRs",
          "name": "Three planes",
          "width": "fill_container",
          "layout": "vertical",
