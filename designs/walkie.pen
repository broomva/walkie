              "id": "QXR0M",
              "name": "Caption",
              "fill": "$lt-slate",
              "textGrowth": "fixed-width",
              "width": 840,
              "content": "Not three layers stacked — three planes that answer in parallel. Any one of them can be busy or dead without silencing the others.",
              "lineHeight": 1.55,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
