        {
          "type": "frame",
          "id": "b82inE",
          "name": "Invisible constraints",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 18,
          "children": [
            {
              "type": "text",
              "id": "sS3do",
              "name": "Caption",
              "fill": "$lt-slate",
              "textGrowth": "fixed-width",
              "width": 830,
              "content": "Two properties of the API that never announce themselves. Both become interface problems, because the only place they can be handled is before the user notices.",
              "lineHeight": 1.55,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "H4r8tY",
              "name": "Grid",
              "width": "fill_container",
              "gap": 32,
              "children": [
                {
                  "type": "frame",
                  "id": "CRhvK",
                  "name": "The 60-minute cap has no event",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "ZbInm",
                      "name": "Rule",
                      "fill": "$lt-amber",
                      "width": "fill_container",
                      "height": 2
                    },
                    {
                      "type": "text",
                      "id": "VgJkT",
                      "name": "H",
                      "fill": "$lt-ink",
                      "content": "The 60-minute cap has no event",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "600",
                      "letterSpacing": -0.1
                    },
                    {
                      "type": "text",
                      "id": "tg8sI",
                      "name": "B",
                      "fill": "$lt-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "No expiry event, no warning, no disconnect reason. The client tracks elapsed time from session.created and re-establishes before the cap, re-seeding from Postgres. On screen it has to read as continuity, not as an error — nothing red, nothing to acknowledge.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "gkvFf",
                      "name": "S",
                      "fill": "$lt-blue-ink",
                      "content": "→ Orb up · re-established",
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "w2KmD",
                  "name": "Truncation is silent and lossy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "pHXDG",
                      "name": "Rule",
                      "fill": "$lt-amber",
                      "width": "fill_container",
                      "height": 2
                    },
                    {
                      "type": "text",
                      "id": "J9alK0",
                      "name": "H",
                      "fill": "$lt-ink",
                      "content": "Truncation is silent and lossy",
                      "fontFamily": "$font",
                      "fontSize": 15,
                      "fontWeight": "600",
                      "letterSpacing": -0.1
                    },
                    {
                      "type": "text",
                      "id": "GSJm0",
                      "name": "B",
                      "fill": "$lt-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "When the window fills, the oldest messages are dropped with no summarization and no error, so the model can stay fluent about a question that is no longer there. The interface can never present the conversation as the record — asks and receipts are read from the store.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "J7aWo",
                      "name": "S",
                      "fill": "$lt-blue-ink",
                      "content": "→ Orb down · undertow",
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "500"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
